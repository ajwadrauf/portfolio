# --- Provider keys (either alone works; missing provider falls back to demo mocks) ---
GEMINI_API_KEY=        # https://aistudio.google.com/apikey — reasoning, Nano Banana stills, Veo video
FAL_KEY=               # https://fal.ai/dashboard/keys — Flux stills, Kling video

# Force demo mode even with keys present (zero spend)
# DRY_RUN=1

# --- Live-mode gate (REQUIRED for any public deployment with real keys) ---
# When LIVE_PASSCODE is set, visitors get demo mode until they enter it.
# Leave unset locally so development with keys just works.
LIVE_PASSCODE=            # long random string; share it in your application
SESSION_SECRET=           # separate long random string for signing cookies
LIVE_BUDGET=40            # live generations allowed per unlocked session

# --- Model ID overrides (verify before first paid call — see README) ---
# GEMINI_REASONING_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image-preview
# GEMINI_IMAGE_FAST_MODEL=gemini-2.5-flash-image
# GEMINI_VEO_MODEL=veo-3.1-generate-preview
# GEMINI_VEO_FAST_MODEL=veo-3.1-fast-generate-preview
# FAL_FLUX_ENDPOINT=fal-ai/flux-2-pro
