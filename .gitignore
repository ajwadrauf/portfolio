# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Reference GIFs: a poster is always static, so these render frame one and
# nothing more — at 20-35MB each. Git keeps every version of a binary forever,
# so keep them out rather than discover it later. The MP4 is the preview.
public/references/*.gif

# Blender clay renders. A 288-frame PNG sequence plus checkpoint stills runs to
# hundreds of MB, and git keeps every version of a binary forever. build.py
# regenerates all of it; the text artifacts beside it are what get reviewed.
blender/out/**/frames/
blender/out/**/checks/
blender/out/**/stills/
blender/out/**/*.mp4
blender/out/**/*.blend

# Python bytecode from the Blender build scripts
__pycache__/
*.pyc
