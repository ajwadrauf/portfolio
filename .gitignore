# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Reference GIFs: a poster is always static, so these render frame one and
# nothing more — at 20-35MB each. Git keeps every version of a binary forever,
# so keep them out rather than discover it later. The MP4 is the preview.
public/references/*.gif

# VELUNE production sources are tracked; local renders and private jobs are not.
/production/velune/source/
/production/velune/exports/
/production/velune/work/blender/*.blend*
/production/velune/work/blender/renders/
/production/velune/work/references/
/production/velune/work/studio/outputs/
/production/velune/work/studio/shot_jobs/
/production/velune/work/studio/.submission.lock/
/production/velune/work/audio/
/production/velune/work/plates/
__pycache__/
